# Copie para .env (local) ou cadastre como variáveis de ambiente na ShardCloud/Render.

# Banco. Sem isso usa SQLite local (bom só para teste rápido; perde dados a cada novo deploy).
# Neon / ShardCloud Database: postgresql://usuario:senha@host/banco?sslmode=require
DATABASE_URL=

# Redis (opcional). Upstash / ShardCloud: rediss://default:senha@host:6379
REDIS_URL=

# OBRIGATÓRIO em produção: uma frase longa e aleatória
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria-de-pelo-menos-32-caracteres

# IA (opcional). Sem chave, o currículo é montado pelo gerador por regras (grátis).
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5

# Admin criado no primeiro start. TROQUE a senha.
ADMIN_LOGIN=admin@empregofacil.app
ADMIN_PASSWORD=troque-esta-senha

# Cria cursos/vagas/usuários de demonstração (marcados como "Exemplo"). Use false em produção real.
SEED_DEMO=true

ENVIRONMENT=production
CORS_ORIGINS=*

# Endereço público (usado nos links das mensagens)
APP_URL=https://empregofacil.shardweb.app

# ---------- WhatsApp (avisos e código de recuperação de senha) ----------
# console = só escreve no log do servidor (padrão) | meta = API oficial do WhatsApp | zapi = Z-API
WHATSAPP_PROVIDER=console
# Meta / WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TPL_CODIGO=empregofacil_codigo
WHATSAPP_TPL_VAGA=empregofacil_vaga_nova
WHATSAPP_TPL_STATUS=empregofacil_status
# Z-API
ZAPI_INSTANCE=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# Avisos: raio em km e máximo de avisos de vaga por pessoa por dia
AVISO_RAIO_KM=10
AVISO_VAGAS_POR_DIA=2

# ---------- E-mail (código de recuperação para contas de empresa) ----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
