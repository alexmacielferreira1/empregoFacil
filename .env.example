# Copie para .env (local) ou cadastre como variáveis de ambiente na ShardCloud/Render.

# Banco. Sem isso usa SQLite local (bom só para teste rápido; perde dados a cada novo deploy).
# Neon / ShardCloud Database: postgresql://usuario:senha@host/banco?sslmode=require
DATABASE_URL=

# Redis (opcional). Upstash / ShardCloud: rediss://default:senha@host:6379
REDIS_URL=

# OBRIGATÓRIO em produção: uma frase longa e aleatória
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria-de-pelo-menos-32-caracteres

# IA (opcional). Sem chave, o currículo é montado pelo gerador por regras (grátis).
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5

# Admin criado no primeiro start. TROQUE a senha.
ADMIN_LOGIN=admin@empregofacil.app
ADMIN_PASSWORD=troque-esta-senha

# Cria cursos/vagas/usuários de demonstração (marcados como "Exemplo"). Use false em produção real.
SEED_DEMO=true

ENVIRONMENT=production
CORS_ORIGINS=*
